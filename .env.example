# -----------------------------------------------------------------------------
# Discord bot
# -----------------------------------------------------------------------------

# Required. Token from Discord Developer Portal -> Bot -> Token.
DISCORD_TOKEN=your_discord_bot_token_here

# Required. Discord server ID where slash commands will be synced.
GUILD_ID=123456789012345678

# Required. Role ID that should see and answer support tickets.
SUPPORT_ROLE_ID=123456789012345678

# Optional. Category ID where ticket channels will be created.
# Leave empty to create ticket channels without a category.
TICKET_CATEGORY_ID=


# -----------------------------------------------------------------------------
# Persistent ticket panel
# -----------------------------------------------------------------------------

# Optional. If channel ID is set, the bot will create or update the support
# ticket panel on startup.
TICKET_PANEL_CHANNEL_ID=

# Optional. Fill this after the bot creates the message if you want it to
# edit the same message after restart instead of creating a new one.
TICKET_PANEL_MESSAGE_ID=


# -----------------------------------------------------------------------------
# Logging and Discord command sync
# -----------------------------------------------------------------------------

# Usually INFO. Use DEBUG only while diagnosing issues.
LOG_LEVEL=INFO

# How long to wait for slash-command sync with Discord, in seconds.
COMMAND_SYNC_TIMEOUT=60


# -----------------------------------------------------------------------------
# Remnawave API
# -----------------------------------------------------------------------------

# Required for /remnawave-active and /remnawave-panel.
# Example: https://panel.example.com
REMNAWAVE_BASE_URL=https://panel.example.com

# Required. API token from Remnawave settings.
REMNAWAVE_API_TOKEN=your_remnawave_api_token_here

# Optional. Fill only if Remnawave is protected by Caddy/Auth Portal.
REMNAWAVE_CADDY_API_KEY=

# API endpoints. Defaults match the bot code.
REMNAWAVE_STATS_PATH=/api/system/stats/recap
REMNAWAVE_NODES_PATH=/api/nodes

# HTTP request timeout for Remnawave API calls, in seconds.
REMNAWAVE_REQUEST_TIMEOUT=15

# Proxy-style headers. Usually safe to leave as-is.
REMNAWAVE_X_FORWARDED_FOR=127.0.0.1
REMNAWAVE_X_FORWARDED_PROTO=https

# Browser-like User-Agent for panels protected by Cloudflare-like checks.
REMNAWAVE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36


# -----------------------------------------------------------------------------
# Persistent Remnawave panel
# -----------------------------------------------------------------------------

# Optional. Fill these after running /remnawave-panel if you want the bot to
# edit the same two messages after restart instead of creating new ones.
REMNAWAVE_PANEL_CHANNEL_ID=
REMNAWAVE_PANEL_MESSAGE_ID=
REMNAWAVE_CONTACTS_MESSAGE_ID=

# Auto-refresh interval for the Remnawave panel. Minimum enforced by code: 30.
REMNAWAVE_PANEL_REFRESH_SECONDS=60

# Kept for compatibility. The panel currently shows all online nodes that fit.
REMNAWAVE_PANEL_TOP_LIMIT=10
